#!/bin/sh
set -eu

if [ -n "${TB_TEST_GO_CALL_LOG:-}" ]; then
    printf 'go build\n' >> "$TB_TEST_GO_CALL_LOG"
fi

output=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o)
            output=$2
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# build-release.sh always supplies -o; failing here keeps the fixture specific
# enough to expose an accidental change to that build contract.
test -n "$output"
printf 'test executable\n' > "$output"
